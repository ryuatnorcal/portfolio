# Prisma Postgres (console.prisma.io): the direct TCP connection string
DATABASE_URL=

# Clerk (dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk user IDs allowed into /admin, comma-separated (user_...)
ADMIN_USER_IDS=

# Cloudflare R2: banner images (token needs Object Read & Write for uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio
R2_BACKGROUNDS_PREFIX=
# Folder listed by the dashboard's project / internal tool media picker
R2_MEDIA_PREFIX="Project and Tools/"

# Only needed once, for `npm run db:seed` to copy the old MongoDB content
MONGOOSE_URI=

# Optional: GitHub release notes widget (defaults to ryuatnorcal/portfolio).
# A token only raises the rate limit; no scopes needed for a public repo.
GITHUB_REPO=
GITHUB_TOKEN=

# Contact form email (Gmail: smtp.gmail.com, port 465, an app password).
# EMAIL_DRY_RUN=true skips sending, for local testing.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_DRY_RUN=
